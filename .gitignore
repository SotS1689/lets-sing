# The old Android app's release signing key and its passwords -- must never
# be committed. Kept in "Important Files".
Important Files/
*.jks
*.keystore

# Web app
web/node_modules/
web/dist/
# generated from the root hymns_data.json + midi/ by prepare-content
web/public/hymns.json
web/public/midi/
web/public/scores/

# Python
__pycache__/
*.pyc

# Old timestamped data backups -- git history replaces these from here on
# (the files themselves are left on disk)
hymns_data.json.*

# Local tool state
.claude/
