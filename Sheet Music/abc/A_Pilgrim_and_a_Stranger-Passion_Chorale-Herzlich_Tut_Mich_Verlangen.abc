%% 6.\t\tThere still my thoughts are dwelling, 'Tis there I long to be! 
%% \t\t\tCome, Lord, and call Thy servant To blessedness with Thee! 
%% \t\t\tCome, bid my toils be ended, Let all my wanderings cease; 
%% \t\t\tCall from the wayside lodging, To the sweet home of peace! 
%%endtext
%%multicol new
%%leftmargin 11cm
%%rightmargin 2cm
%%textfont Times-Roman 13.0
%%begintext obeylines justify
%% 7.\t\tThere I shall dwell forever, No more a stranger guest, 
%% \t\t\tWith all Thy blood-bought children In everlasting rest. 
%% \t\t\tThe pilgrim toils forgotten, The pilgrim conflicts o'er, 
%% \t\t\tAll earthly griefs behind us, Eternal joys before! 
%%endtext
