%%begintext obeylines justify
%% 6.\t\tMy walk is heav'nward all the way, 
%% \t\t\tAwait, my soul, the morrow, 
%% \t\tWhen thou shalt find release for aye 
%% \t\t\tFrom all thy sin and sorrow; 
%%endtext
%%multicol new
%%leftmargin 11cm
%%rightmargin 2cm
%%textfont Times-Roman 13.0
%%begintext obeylines justify
%% \t\tAll worldly pomp, begone, 
%% \t\t\tTo heav'n I now press on; 
%% \t\tFor all the world I would not stay, 
%% \t\t\tMy walk is heav'nward all the way. 
%%endtext
%%multicol end

