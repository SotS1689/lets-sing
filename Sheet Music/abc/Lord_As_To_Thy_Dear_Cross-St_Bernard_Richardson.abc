%OHSCRIP Ps 143:8-11, Jer 9:7, Zech 13:9, Mal 3:3
%OHTOPICS {Consecration}, {Contrition}, {Courage in Affliction}, {Cross}, {Example, Christ's}, {Following Jesus, Sanctification}, {Forgiveness}, {Guidance}, {Heaven}, {Repentance}, {Submission (see also Following Jesus, God - Providence of, Trust)}
